Attribute VB_Name = "modHAMU_Language"
Option Explicit
Option Private Module
Private mEnglish As Object
Public Function HAMU_L(ByVal turkish As String, ByVal english As String) As String
 If HAMU_Setting("Language") = "en" Then HAMU_L = english Else HAMU_L = turkish
End Function
Public Function HAMU_Translate(ByVal value As String) As String
 HAMU_Translate = value
 If HAMU_Setting("Language") <> "en" Then Exit Function
 If mEnglish Is Nothing Then HAMU_InitEnglish
 If mEnglish.exists(value) Then HAMU_Translate = CStr(mEnglish(value))
End Function
Public Sub HAMU_LocalizeForm(ByVal form As Object)
 If HAMU_Setting("Language") <> "en" Then Exit Sub
 On Error Resume Next
 form.Caption = HAMU_Translate(form.Caption)
 HAMU_LocalizeControls form.controls
End Sub
Private Sub HAMU_LocalizeControls(ByVal controls As Object)
 Dim item As Object
 For Each item In controls
  On Error Resume Next
  item.Caption = HAMU_Translate(item.Caption)
  item.ControlTipText = HAMU_Translate(item.ControlTipText)
  If TypeName(item) = "Frame" Then HAMU_LocalizeControls item.controls
  On Error GoTo 0
 Next item
End Sub
